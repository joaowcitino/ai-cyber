{
  "manifest_version": 2,
  "name": "Privacy Tracker Detector",
  "version": "1.0.0",
  "description": "Detecta rastreadores, cookies, fingerprinting e indicadores de hijacking em páginas web.",
  "browser_specific_settings": {
    "gecko": { "id": "privacy-tracker-detector@insper-cyber.local" }
  },
  "permissions": ["webNavigation", "webRequest", "webRequestBlocking", "cookies", "tabs", "storage", "<all_urls>"],
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["content/injected.js"]
}
